APP_ENV=development
APP_URL=http://localhost:8000
SECRET_KEY=change-me-before-production
DATABASE_URL=sqlite:///./panmajster.db
DATABASE_SCHEMA=panmajster
STORAGE_PROVIDER=local_disk
MEDIA_ROOT=./data
WORKER_ENABLED=true
WORKER_POLL_SECONDS=5
MAX_UPLOAD_MB=40

OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REPORT_MODEL=gpt-4.1-mini

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pan Majster <noreply@panmajster.pl>
SMTP_STARTTLS=true

ADMIN_EMAILS=
